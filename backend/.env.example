# copy to backend/.env and fill in -- that file is gitignored, never commit real keys

# required -- powers the LangGraph briefing agent and chat (agent/briefing_agent.py, agent/qa_agent.py)
ANTHROPIC_API_KEY=

# optional but recommended -- without these, OpenSky falls back to its anonymous tier
# (400 credits/day), which this project's polling rate exhausts almost immediately.
# Register a free OAuth2 client at https://opensky-network.org for 4,000/day instead.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
